<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CADisableMinimumFrameDurationOnPhone</key>
        <true/>
        <!-- Warlock's only encryption is the platform TLS it uses to reach the game servers, which
             falls under the standard exemption. Declaring it here stops App Store Connect asking
             the export-compliance question on every single upload. -->
        <key>ITSAppUsesNonExemptEncryption</key>
        <false/>
    </dict>
</plist>
